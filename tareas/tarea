public class Tarea {

    private String descripcion;
    private String prioridad;
    private boolean estaCompletada;

    public Tarea(String descripcion, String prioridad) {
        this.descripcion = descripcion;
        this.prioridad = prioridad;
        this.estaCompletada = false;
    }

    public String getDescripcion() {
        return this.descripcion;
    }

    public void setDescripcion(String descripcion) {
        this.descripcion = descripcion;
    }

    public String getPrioridad() {
        return this.prioridad;
    }

    public void setPrioridad(String prioridad) {
        this.prioridad = prioridad;
    }

    public boolean isEstaCompletada() {
        return this.estaCompletada;
    }

    public void setEstaCompletada(boolean estado) {
        this.estaCompletada = estado;
    }

    public void marcarComoCompletada() {
        this.estaCompletada = true;
    }

    public boolean esUrgente() {
        boolean esAlta = this.prioridad.equals("Alta");
        boolean noEstaLista = !this.estaCompletada;

        if (esAlta && noEstaLista) {
            return true;
        } else {
            return false;
        }
    }
}
