public class CuentaAhorros {

    private String numeroCuenta;
    private String nombreTitular;
    private double saldoActual;

    public CuentaAhorros(String numero, String titular, double saldoInicial) {
        this.numeroCuenta = numero;
        this.nombreTitular = titular;
        if (saldoInicial >= 0) {
            this.saldoActual = saldoInicial;
        } else {
            this.saldoActual = 0;
            System.out.println("Aviso: Saldo inicial ajustado a 0.");
        }
    }

    public String getNumeroCuenta() {
        return numeroCuenta; }
    public String getNombreTitular() {
        return nombreTitular; }
    public double getSaldoActual() {
        return saldoActual; }

    public void depositar(double cantidad) {
        if (cantidad > 0) {
            this.saldoActual = this.saldoActual + cantidad;
            System.out.println("--- Depósito exitoso. Nuevo saldo: $" + this.saldoActual);
        } else {
            System.out.println("Error: Cantidad inválida.");
        }
    }

    public void retirar(double cantidad) {
        if (cantidad > 0) {
            if (cantidad <= this.saldoActual) {
                this.saldoActual = this.saldoActual - cantidad;
                System.out.println("--- Retiro exitoso. Queda: $" + this.saldoActual);
            } else {
                System.out.println("Error: Fondos insuficientes.");
            }
        } else {
            System.out.println("Error: Cantidad inválida.");
        }
    }
}
